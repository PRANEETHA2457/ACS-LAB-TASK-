import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        long prev2 = 0, prev1 = 0;

        for (int i = 0; i < n; i++) {
            long x = sc.nextLong();

            long cur = Math.max(prev1, prev2 + x);

            prev2 = prev1;
            prev1 = cur;
        }

        System.out.println(prev1);
        sc.close();
    }
}
